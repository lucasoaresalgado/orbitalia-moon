# Orbitalia Moon environment. Secrets are NOT stored here: point the *_FILE variables at
# systemd credentials or Podman secrets (scope §13).

DATABASE_URL=postgres://platform@127.0.0.1:5432/platform
# Password for DATABASE_URL, read from a file and spliced in at startup.
DATABASE_PASSWORD_FILE=~/.config/miniasys/secrets/pg_password

ANTHROPIC_API_KEY_FILE=~/.config/miniasys/secrets/anthropic
COLIBRI_URL=http://127.0.0.1:8000
OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=bge-m3

PODMAN_SOCKET=/run/user/1000/podman/podman.sock
SANDBOX_IMAGE=localhost/agent-sandbox:dev
WORKSPACES_DIR=~/miniasys/workspaces
# each project's code (git), its storage (/storage in script runs) and dependency caches
PROJECTS_DIR=~/miniasys/projects
STORAGE_DIR=~/miniasys/storage
DEPS_DIR=~/miniasys/deps
LAKEHOUSE_DIR=/mnt/data/lakehouse
BACKUP_DIR=/mnt/data/miniasys/backups
LOG_DIR=/mnt/data/miniasys/logs
SKILLS_DIR=~/miniasys/skills

GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_FILE=~/.config/miniasys/secrets/github-app.pem
GITHUB_INSTALLATION_ID=

NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
# Encrypts app-level secrets (AES-256-GCM): "<key id>:<32 bytes base64>"
MASTER_KEY_FILE=~/.config/miniasys/secrets/master_key

# argon2id hash of the single user's password, from a file or inline:
# `pnpm --filter @miniasys/web hash-password`
APP_PASSWORD_HASH_FILE=
APP_PASSWORD_HASH=
TIMEZONE=America/Sao_Paulo
