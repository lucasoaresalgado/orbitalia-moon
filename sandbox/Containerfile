# The agent sandbox image (scope §10): one prebuilt image with Python, Node,
# DuckDB CLI, git, common test runners and the scanners. Nothing is downloaded
# at run time unless a run's network access was approved.
# Build: scripts/build-sandbox.sh  →  localhost/agent-sandbox:dev
FROM docker.io/library/node:22-bookworm-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
      bash ca-certificates curl git jq unzip make python3 python3-pip python3-venv ripgrep \
    && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@9.15.4 --activate

# Claude Code, for roles on the Claude subscription engine (it signs in with CLAUDE_CODE_OAUTH_TOKEN at run time)
ARG CLAUDE_CODE_VERSION=2.1.322
RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" && npm cache clean --force

# the runtime settings shared by both stages (the root filesystem is read-only at run time: caches go to /tmp)
ENV HOME=/tmp/home XDG_CACHE_HOME=/tmp/cache npm_config_cache=/tmp/npm-cache PNPM_HOME=/tmp/pnpm PIP_CACHE_DIR=/tmp/pip-cache \
    PYTHONDONTWRITEBYTECODE=1 GIT_CONFIG_NOSYSTEM=1
WORKDIR /workspace
CMD ["bash"]

# the full image: test runners, DuckDB and the scanners (the default build target)
FROM base AS full
ARG DUCKDB_VERSION=1.3.2
ARG GITLEAKS_VERSION=8.28.0
ARG TRIVY_VERSION=0.65.0
ARG OSV_VERSION=2.2.2
RUN pip3 install --no-cache-dir --break-system-packages pytest ruff mypy semgrep duckdb pandas pyarrow

RUN curl -fsSL "https://github.com/duckdb/duckdb/releases/download/v${DUCKDB_VERSION}/duckdb_cli-linux-amd64.zip" -o /tmp/duckdb.zip \
    && unzip /tmp/duckdb.zip -d /usr/local/bin && rm /tmp/duckdb.zip \
    && curl -fsSL "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" | tar -xz -C /usr/local/bin gitleaks \
    && curl -fsSL "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz" | tar -xz -C /usr/local/bin trivy \
    && curl -fsSL "https://github.com/google/osv-scanner/releases/download/v${OSV_VERSION}/osv-scanner_linux_amd64" -o /usr/local/bin/osv-scanner \
    && chmod +x /usr/local/bin/osv-scanner

# the root filesystem is read-only at run time: caches go to the /tmp tmpfs
ENV HOME=/tmp/home \
    XDG_CACHE_HOME=/tmp/cache \
    npm_config_cache=/tmp/npm-cache \
    PNPM_HOME=/tmp/pnpm \
    PIP_CACHE_DIR=/tmp/pip-cache \
    PYTHONDONTWRITEBYTECODE=1 \
    GIT_CONFIG_NOSYSTEM=1

WORKDIR /workspace
CMD ["bash"]
